#!/usr/bin/env python3
from __future__ import annotations

import sys
sys.dont_write_bytecode = True

import argparse
import json
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))

from promotion_qualifier import (
    CATEGORY_COMMAND_FAILURE,
    CATEGORY_INTERNAL_ERROR,
    CATEGORY_REQUEST_VALIDATION,
    DEFAULT_TIMEOUT_SECONDS,
    MAX_TIMEOUT_SECONDS,
    MIN_TIMEOUT_SECONDS,
    PromotionQualificationError,
    build_empty_result,
    qualify_candidate,
    validate_timeout_seconds,
)


import os
import signal

# SIGTERM cancellation is control flow: the promotion engine catches
# Exception for internal failures, but this must reach the CLI signal handler.
class InterruptedBySignal(BaseException):
    def __init__(self, signum: int):
        self.signum = signum
        self.sig_name = (
            "SIGTERM"
            if signum == signal.SIGTERM
            else "SIGINT"
            if signum == signal.SIGINT
            else f"signal {signum}"
        )
        super().__init__(f"interrupted by {self.sig_name}")


class QualificationArgumentParser(argparse.ArgumentParser):
    """Argument parser that raises ArgumentError when --json is present instead of sys.exit."""

    def error(self, message: str) -> None:
        if "--json" in sys.argv[1:]:
            raise argparse.ArgumentError(None, message)
        super().error(message)


def main() -> int:
    parser = QualificationArgumentParser(
        description="Qualify a candidate public module promotion non-mutatively",
        allow_abbrev=False,
    )
    parser.add_argument(
        "--input",
        required=True,
        help="Direct registered module input name (e.g. developer-ux_dinas)",
    )
    parser.add_argument(
        "--candidate",
        required=True,
        help="Exact candidate flake reference with ?rev=<40-hex-commit>",
    )
    parser.add_argument(
        "--composition",
        type=Path,
        default=ROOT,
        help="Path to composition-nd repository root (default: repository containing this tool)",
    )
    parser.add_argument(
        "--timeout-seconds",
        type=float,
        default=DEFAULT_TIMEOUT_SECONDS,
        help=f"Per-command timeout in seconds (default: {DEFAULT_TIMEOUT_SECONDS})",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit full machine-readable qualification result as JSON to stdout",
    )

    try:
        args = parser.parse_args()
    except argparse.ArgumentError as err:
        err_msg = str(err).strip()
        # Recover partial request context if available without raising on missing required flags
        input_name = ""
        candidate_ref = ""
        effective_timeout = DEFAULT_TIMEOUT_SECONDS
        try:
            for i, arg in enumerate(sys.argv):
                if arg == "--input" and i + 1 < len(sys.argv):
                    input_name = sys.argv[i + 1]
                elif arg.startswith("--input="):
                    input_name = arg.split("=", 1)[1]
                elif arg == "--candidate" and i + 1 < len(sys.argv):
                    candidate_ref = sys.argv[i + 1]
                elif arg.startswith("--candidate="):
                    candidate_ref = arg.split("=", 1)[1]
                elif arg == "--timeout-seconds" and i + 1 < len(sys.argv):
                    try:
                        effective_timeout = validate_timeout_seconds(float(sys.argv[i + 1]))
                    except Exception:
                        pass
                elif arg.startswith("--timeout-seconds="):
                    try:
                        effective_timeout = validate_timeout_seconds(float(arg.split("=", 1)[1]))
                    except Exception:
                        pass
        except Exception:
            pass

        result = build_empty_result(
            input_name=input_name,
            candidate_ref=candidate_ref,
            failure_category=CATEGORY_REQUEST_VALIDATION,
            failure_message=f"command-line argument error: {err_msg}",
            details={"error": err_msg[:500]},
            timeout_seconds=effective_timeout,
        )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 1

    try:
        validated_timeout = validate_timeout_seconds(args.timeout_seconds)
    except PromotionQualificationError as err:
        if args.json:
            result = build_empty_result(
                input_name=args.input,
                candidate_ref=args.candidate,
                failure_category=err.category,
                failure_message=f"invalid --timeout-seconds: {err.message}",
                details={"timeoutSeconds": args.timeout_seconds},
                timeout_seconds=DEFAULT_TIMEOUT_SECONDS,
            )
            print(json.dumps(result, indent=2, sort_keys=True))
            return 1
        else:
            print(
                f"composition-nd qualify-promotion: error: --timeout-seconds must be a finite number between {MIN_TIMEOUT_SECONDS} and {MAX_TIMEOUT_SECONDS}, got {args.timeout_seconds}",
                file=sys.stderr,
            )
            return 2

    def _top_sigterm(signum: int, _frame: Any) -> None:
        raise InterruptedBySignal(signum)

    old_sigterm: Any = None
    try:
        old_sigterm = signal.signal(signal.SIGTERM, _top_sigterm)
    except (ValueError, TypeError, OSError):
        pass

    try:
        try:
            # Test-only synchronization: signal only after handler is installed
            # AND control has entered the exception-to-JSON boundary.
            ready_fd_text = os.environ.get("COMPOSITION_QUALIFIER_SIGTERM_READY_FD")
            if ready_fd_text is not None:
                ready_fd = int(ready_fd_text)
                if ready_fd < 3:
                    raise ValueError("invalid SIGTERM readiness descriptor")
                try:
                    os.write(ready_fd, b"R")
                finally:
                    os.close(ready_fd)
            result = qualify_candidate(
                composition_root=args.composition,
                input_name=args.input,
                candidate_ref=args.candidate,
                timeout_seconds=validated_timeout,
            )
        except KeyboardInterrupt:
            result = build_empty_result(
                input_name=args.input,
                candidate_ref=args.candidate,
                failure_category=CATEGORY_COMMAND_FAILURE,
                failure_message="qualification cancelled by operator interruption",
                details={"interrupted": True, "signal": "SIGINT"},
                timeout_seconds=validated_timeout,
            )
        except InterruptedBySignal as sig_err:
            result = build_empty_result(
                input_name=args.input,
                candidate_ref=args.candidate,
                failure_category=CATEGORY_COMMAND_FAILURE,
                failure_message=f"qualification cancelled by {sig_err.sig_name}",
                details={"interrupted": True, "signal": sig_err.sig_name},
                timeout_seconds=validated_timeout,
            )
        except Exception as error:
            result = build_empty_result(
                input_name=args.input,
                candidate_ref=args.candidate,
                failure_category=CATEGORY_INTERNAL_ERROR,
                failure_message=f"unexpected internal error during qualification: {error}",
                details={"type": type(error).__name__},
                timeout_seconds=validated_timeout,
            )
    finally:
        if old_sigterm is not None:
            try:
                signal.signal(signal.SIGTERM, old_sigterm)
            except (ValueError, TypeError, OSError):
                pass

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        if result["outcome"] == "pass":
            print(
                f"composition-nd qualify-promotion: PASS "
                f"(input: {args.input}, lock identical: {result['lock']['byteIdentical']})"
            )
        else:
            fail_msg = (
                result.get("failure", {}).get("message", "qualification failed")
                if result.get("failure")
                else "qualification failed"
            )
            print(
                f"composition-nd qualify-promotion: FAIL - {fail_msg}",
                file=sys.stderr,
            )

    return 0 if result["outcome"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
