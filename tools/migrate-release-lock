#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))

from lock_transition import LockTransitionError, update_lock_transactionally


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Perform the one-time narrow Developer UX release-channel lock update"
    )
    parser.add_argument("--report", required=True, type=Path)
    args = parser.parse_args()
    try:
        report = update_lock_transactionally(ROOT, args.report)
    except LockTransitionError as error:
        print(str(error), file=sys.stderr)
        return 1
    print(json.dumps(report, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
